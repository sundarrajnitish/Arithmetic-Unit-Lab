# Arithmetic Unit Lab - Quartus Prime settings (Nitish Sundarraj)
# Same MAX 10 device as the 2023 course project.  Change TOP_LEVEL_ENTITY to
# arith_unit_min or arith_unit_serial to build the other tops.
set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M08DAF484C8G
set_global_assignment -name TOP_LEVEL_ENTITY arith_unit
set_global_assignment -name VHDL_INPUT_VERSION VHDL_1993
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE arith_unit.sdc
set_global_assignment -name TIMING_ANALYZER_MULTICORNER_ANALYSIS ON
set_global_assignment -name VHDL_FILE ../../rtl/au_pkg.vhd
set_global_assignment -name VHDL_FILE ../../rtl/cells/half_adder.vhd
set_global_assignment -name VHDL_FILE ../../rtl/cells/full_adder.vhd
set_global_assignment -name VHDL_FILE ../../rtl/cells/pp_cell.vhd
set_global_assignment -name VHDL_FILE ../../rtl/cells/pg_black.vhd
set_global_assignment -name VHDL_FILE ../../rtl/cells/reg_en.vhd
set_global_assignment -name VHDL_FILE ../../rtl/cells/dff_en.vhd
set_global_assignment -name VHDL_FILE ../../rtl/arith/ripple_adder.vhd
set_global_assignment -name VHDL_FILE ../../rtl/arith/kogge_stone_adder.vhd
set_global_assignment -name VHDL_FILE ../../rtl/arith/cpa.vhd
set_global_assignment -name VHDL_FILE ../../rtl/arith/array_multiplier.vhd
set_global_assignment -name VHDL_FILE ../../rtl/arith/dadda_multiplier.vhd
set_global_assignment -name VHDL_FILE ../../rtl/arith/multiplier.vhd
set_global_assignment -name VHDL_FILE ../../rtl/arith/shift_divider.vhd
set_global_assignment -name VHDL_FILE ../../rtl/arith/restoring_divider.vhd
set_global_assignment -name VHDL_FILE ../../rtl/top/arith_unit_min.vhd
set_global_assignment -name VHDL_FILE ../../rtl/top/arith_unit.vhd
set_global_assignment -name VHDL_FILE ../../rtl/top/arith_unit_serial.vhd
# Speed build: Dadda tree + the device's carry chain for every adder
set_parameter -name MULT_ARCH DADDA
set_parameter -name CPA_ARCH INFERRED
